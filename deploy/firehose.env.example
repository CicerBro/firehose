# Firehose server configuration (build plan §5.2).
#
# Docker:    cp firehose.env.example firehose.env   (read by deploy/docker-compose.yml)
# systemd:   install -m 600 firehose.env.example /etc/firehose.env
#
# Every variable has a flag equivalent: FIREHOSE_MAX_CONNECTIONS <-> --max-connections.
# Flags override environment variables. Sizes accept KiB/MiB/GiB; durations use Go syntax.
# Commented-out lines show the default.

# ---- Required in production ----

# UI origin (scheme + host, no trailing slash). Used for the CORS allowlist and CSP.
FIREHOSE_PUBLIC_URL=https://speed.example.com

# Test-stream origins (one per DNS name). Empty = single-origin mode: streams go to
# PUBLIC_URL and the browser is capped at 6 connections.
FIREHOSE_TEST_HOSTS=https://s1.speed.example.com,https://s2.speed.example.com,https://s3.speed.example.com,https://s4.speed.example.com,https://s5.speed.example.com,https://s6.speed.example.com,https://s7.speed.example.com,https://s8.speed.example.com

# Bearer token for the CLI client. Generate with: openssl rand -hex 32
# Empty disables bearer access (browser/Authelia only). Never commit the real value.
FIREHOSE_API_TOKEN=

# Name shown in the UI and in CLI results (default: hostname).
FIREHOSE_SERVER_NAME=ams-1

# ---- Network ----

# HTTP listen address. Traefik proxies to this; keep it on loopback.
#FIREHOSE_LISTEN=127.0.0.1:8080

# CIDRs whose X-Forwarded-For is trusted (Traefik on the same host).
#FIREHOSE_TRUSTED_PROXIES=127.0.0.1/32,::1/128

# Header Authelia sets via Traefik authResponseHeaders.
#FIREHOSE_AUTH_HEADER=Remote-User

# ---- Packet loss (WebRTC) ----

#FIREHOSE_RTC_ENABLED=true
# Single UDP port for all WebRTC traffic. Open it in the firewall.
#FIREHOSE_RTC_UDP_PORT=50000
# Public IPs to advertise as ICE host candidates. Only needed behind NAT.
#FIREHOSE_RTC_PUBLIC_IPS=203.0.113.10,2001:db8::10

# ---- Safety limits ----

#FIREHOSE_MAX_ACTIVE_SESSIONS=1
#FIREHOSE_MAX_CONNECTIONS=32
#FIREHOSE_MAX_REQUEST_DURATION=35s
#FIREHOSE_MAX_DOWNLOAD_BYTES=4GiB
#FIREHOSE_MAX_UPLOAD_BYTES=512MiB
#FIREHOSE_SESSION_TTL=120s
#FIREHOSE_SESSION_MAX_AGE=5m

# ---- Observability ----

#FIREHOSE_LOG_LEVEL=info
#FIREHOSE_LOG_FORMAT=json
# e.g. 127.0.0.1:9090 to expose Prometheus /metrics. Empty = off.
#FIREHOSE_METRICS_LISTEN=

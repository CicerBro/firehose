# Bare-metal alternative to Docker (build plan §12.5).
#
#   sudo install -m 755 speedtest /usr/local/bin/speedtest
#   sudo install -m 600 deploy/speedtest.env.example /etc/speedtest.env   # then edit
#   sudo cp deploy/systemd/speedtest.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now speedtest

[Unit]
Description=Speedtest server (self-hosted network speed test)
Documentation=https://github.com/CicerBro/speedtest
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/speedtest serve
EnvironmentFile=/etc/speedtest.env
Restart=on-failure
RestartSec=2s
# Graceful shutdown on SIGTERM takes up to 10 s.
TimeoutStopSec=20s
LimitNOFILE=65536

# Sandboxing. The server needs no files, no privileges and only IP sockets
# (AF_NETLINK is used by pion/WebRTC to enumerate interfaces).
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
CapabilityBoundingSet=
AmbientCapabilities=

[Install]
WantedBy=multi-user.target
